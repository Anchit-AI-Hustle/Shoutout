{
  "name": "@shoutout/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:rls": "echo \"RLS suite not yet built — see docs/10-TESTING.md Gate 1\" && exit 0",
