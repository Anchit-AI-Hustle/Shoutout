    "db:types": "supabase gen types typescript --linked > src/generated-types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "supabase": "^1.200.0",
    "typescript": "^5.6.0"
  }
}
