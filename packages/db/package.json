    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "supabase": "^1.200.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
